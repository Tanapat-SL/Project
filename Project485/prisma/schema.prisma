generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Platform {
  PC
  PLAYSTATION
  XBOX
  SWITCH
  MOBILE
}

enum PlayStyle {
  COMPETITIVE
  CASUAL
  CHILL
  LEARNING
}

enum GameMode {
  RANKED
  CASUAL
  COOP
  CUSTOM
}

enum PartyStatus {
  OPEN
  FULL
  CLOSED
}

enum PartyRole {
  OWNER
  MEMBER
}

enum MemberStatus {
  PENDING
  ACCEPTED
  REJECTED
  LEFT
  KICKED
}

enum ConversationType {
  PARTY
  DIRECT
}

enum NotificationType {
  PARTY_JOIN_REQUEST
  PARTY_REQUEST_ACCEPTED
  PARTY_REQUEST_REJECTED
  NEW_MESSAGE
  PARTY_INVITE
  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// ─────────────────────────────────────────────
// Users & Games
// ─────────────────────────────────────────────

/// บัญชีผู้ใช้ — ล็อกอินผ่าน Discord OAuth เท่านั้น จึงไม่มีฟิลด์รหัสผ่าน
model User {
  id        Int      @id @default(autoincrement())
  discordId String   @unique
  username  String
  displayName String?
  email     String?  @unique
  avatarUrl String?
  bio       String?  @db.VarChar(500)
  languages String[] @default([])
  timezone  String   @default("Asia/Bangkok")
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games              UserGame[]
  availability       Availability[]
  partiesOwned       Party[]              @relation("PartyOwner")
  partyMemberships   PartyMember[]
  conversations      ConversationMember[]
  messages           Message[]
  notifications      Notification[]
  blocking           UserBlock[]          @relation("Blocker")
  blockedBy          UserBlock[]          @relation("Blocked")
  reportsMade        Report[]             @relation("Reporter")
  reportsReceived    Report[]             @relation("ReportTarget")
  friendRequestsSent     FriendRequest[] @relation("FriendRequester")
  friendRequestsReceived FriendRequest[] @relation("FriendReceiver")
}

model Game {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  slug     String  @unique
  imageUrl String?
  /// ลำดับแรงก์จากต่ำไปสูง ใช้เทียบระดับฝีมือ (ว่างได้ถ้าเกมไม่มีแรงก์)
  ranks    String[] @default([])

  players UserGame[]
  parties Party[]
}

/// เกมที่ผู้ใช้เล่น (User M:N Game)
model UserGame {
  id         Int        @id @default(autoincrement())
  userId     Int
  gameId     Int
  rank       String?
  platform   Platform   @default(PC)
  playStyle  PlayStyle  @default(CASUAL)
  micEnabled Boolean    @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

/// ช่วงเวลาที่สะดวกเล่น (dayOfWeek: 0 = อาทิตย์ … 6 = เสาร์, เวลาเป็น "HH:mm" ตาม timezone ของผู้ใช้)
model Availability {
  id        Int    @id @default(autoincrement())
  userId    Int
  dayOfWeek Int
  startTime String
  endTime   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// Parties
// ─────────────────────────────────────────────

model Party {
  id          Int         @id @default(autoincrement())
  ownerId     Int
  gameId      Int
  title       String      @db.VarChar(100)
  description String?     @db.VarChar(1000)
  mode        GameMode    @default(CASUAL)
  rankMin     String?
  rankMax     String?
  maxMembers  Int         @default(5)
  micRequired Boolean     @default(false)
  language    String?
  region      String?
  status      PartyStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner        User          @relation("PartyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  game         Game          @relation(fields: [gameId], references: [id])
  members      PartyMember[]
  conversation Conversation?

  @@index([gameId])
  @@index([status])
  @@index([createdAt])
  @@index([ownerId])
}

/// สมาชิกปาร์ตี้และคำขอเข้าร่วม (Party M:N User)
model PartyMember {
  id       Int          @id @default(autoincrement())
  partyId  Int
  userId   Int
  role     PartyRole    @default(MEMBER)
  status   MemberStatus @default(PENDING)
  message  String?      @db.VarChar(300)
  joinedAt DateTime     @default(now())
  updatedAt DateTime    @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
  @@index([userId])
  @@index([partyId, status])
}

// ─────────────────────────────────────────────
// Chat
// ─────────────────────────────────────────────

/// ห้องแชท — ห้องของปาร์ตี้ (สิทธิ์อิงจากสมาชิกปาร์ตี้ที่ ACCEPTED) หรือแชทส่วนตัว (อิงจาก ConversationMember)
model Conversation {
  id        Int              @id @default(autoincrement())
  type      ConversationType
  partyId   Int?             @unique
  createdAt DateTime         @default(now())

  party    Party?               @relation(fields: [partyId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId Int
  userId         Int
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String   @db.VarChar(2000)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────
// Notifications & Safety
// ─────────────────────────────────────────────

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model FriendRequest {
  id          Int                 @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
}

model UserBlock {
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id           Int          @id @default(autoincrement())
  reporterId   Int
  targetUserId Int
  reason       String       @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  reporter   User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetUserId])
}
